                }
              }
            },
            {
              "$ref": "#/$defs/candidateCheck",
              "properties": {
                "id": {
                  "const": "claim-surface-capsule"
                }
              }
            },
            {
              "$ref": "#/$defs/candidateCheck",
              "properties": {
                "id": {
                  "const": "candidate-manifest-stable"
                }
              }
            }
          ],
          "items": false
        },
        "next_gate": {
          "const": "Capture source-bound staged browser evidence and obtain separate named manual pixel review and human visual acceptance; this staged candidate cannot apply, package, or deploy itself."
