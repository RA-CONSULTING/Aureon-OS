                "id": {
                  "const": "candidate-workspace"
                }
              }
            },
            {
              "$ref": "#/$defs/candidateCheck",
              "properties": {
                "id": {
                  "const": "candidate-manifest"
                }
              }
            },
            {
              "$ref": "#/$defs/candidateCheck",
              "properties": {
                "id": {
                  "const": "candidate-diff"
                }
              }
            },
            {
              "$ref": "#/$defs/candidateCheck",
              "properties": {
                "id": {
                  "const": "exact-scope"
                }
              }
            },
            {
              "$ref": "#/$defs/candidateCheck",
              "properties": {
                "id": {
                  "const": "no-public-file-removal"
                }
              }
            },
            {
              "$ref": "#/$defs/candidateCheck",
              "properties": {
                "id": {
                  "const": "blocked-files"
                }
              }
            },
            {
              "$ref": "#/$defs/candidateCheck",
              "properties": {
                "id": {
                  "const": "strict-text-integrity"
                }
              }
            },
            {
              "$ref": "#/$defs/candidateCheck",
              "properties": {
                "id": {
                  "const": "remote-origin-diff"
                }
              }
            },
            {
              "$ref": "#/$defs/candidateCheck",
              "properties": {
                "id": {
                  "const": "secret-scan"
                }
              }
            },
            {
              "$ref": "#/$defs/candidateCheck",
              "properties": {
                "id": {
                  "const": "trusted-binary-import-replay"
                }
              }
            },
            {
              "$ref": "#/$defs/candidateCheck",
              "properties": {
                "id": {
                  "const": "trusted-editorial-surface-replay"
                }
              }
            },
            {
              "$ref": "#/$defs/candidateCheck",
              "properties": {
                "id": {
                  "const": "claim-impact-declarations"
                }
              }
            },
            {
              "$ref": "#/$defs/candidateCheck",
