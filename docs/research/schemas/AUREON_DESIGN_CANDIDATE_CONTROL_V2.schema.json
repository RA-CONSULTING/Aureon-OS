        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "baseline_tree_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "website_path",
        "tree_sha256",
        "file_count",
        "total_bytes"
      ],
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^artifacts/website-candidates/[a-z0-9][a-z0-9._-]{2,80}$"
        },
        "website_path": {
          "type": "string",
          "pattern": "^artifacts/website-candidates/[a-z0-9][a-z0-9._-]{2,80}/website$"
        },
        "tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "candidateChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "change",
        "before_sha256",
        "after_sha256",
        "before_bytes",
        "after_bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "change": {
          "enum": [
            "added",
            "modified",
            "removed"
          ]
        },
        "before_sha256": {
          "type": "string",
          "pattern": "^$|^[A-F0-9]{64}$"
        },
        "after_sha256": {
          "type": "string",
          "pattern": "^$|^[A-F0-9]{64}$"
        },
        "before_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "after_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "change": {
                "const": "added"
              }
            },
            "required": [
              "change"
            ]
          },
          "then": {
            "properties": {
              "before_sha256": {
                "const": ""
              },
              "before_bytes": {
                "const": null
              },
              "after_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "after_bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "change": {
                "const": "removed"
              }
            },
            "required": [
              "change"
            ]
          },
          "then": {
            "properties": {
              "before_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "before_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "after_sha256": {
                "const": ""
              },
              "after_bytes": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "change": {
                "const": "modified"
              }
            },
            "required": [
              "change"
            ]
          },
          "then": {
            "properties": {
              "before_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "before_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "after_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "after_bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "candidateClaimSurface": {
      "type": "object",
