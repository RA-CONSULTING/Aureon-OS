      "properties": {
        "path": {
          "type": "string",
          "pattern": "^artifacts/website-candidates/[a-z0-9][a-z0-9._-]{2,80}/candidate-validation-input\\.v1\\.json$"
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "json_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "candidateWorkOrderBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "path",
        "file_sha256",
        "sha256",
        "baseline_tree_sha256"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"
        },
        "path": {
          "type": "string",
          "pattern": "^artifacts/website-candidates/work-orders/[a-z0-9][a-z0-9._-]{2,80}\\.v4\\.json$"
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
