          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executableSourceClosureExclusion"
          }
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "candidateValidationInput": {
      "type": "object",
