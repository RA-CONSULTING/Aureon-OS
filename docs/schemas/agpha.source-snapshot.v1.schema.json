{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureoninstitute.com/schemas/agpha.source-snapshot.v1.schema.json",
  "title": "AGPHA immutable source snapshot manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "created_at",
    "files",
    "queries",
    "registry_version",
    "schema_version",
    "metadata"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/query"
      }
    },
    "registry_version": {
      "const": "agpha.source-registry.v1"
    },
    "schema_version": {
      "const": "agpha.source-snapshot.v1"
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relpath",
        "source_id",
        "source_record_id",
        "retrieved_at",
        "licence_or_terms",
        "size_bytes",
        "sha256",
        "media_type",
        "notes"
      ],
      "properties": {
        "relpath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1
        },
        "licence_or_terms": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "$ref": "#/$defs/nullableString"
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "source_id",
        "request_sha256",
        "status",
        "result_count",
        "retrieved_at",
        "response_relpath",
        "response_sha256",
        "notes"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "complete",
            "zero_result",
            "failed"
          ]
        },
        "result_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1
        },
        "response_relpath": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "response_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "zero_result"
              }
            }
          },
          "then": {
            "properties": {
              "result_count": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "result_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "anyOf": [
    {
      "properties": {
        "files": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "queries": {
          "minItems": 1
        }
      }
    }
  ]
}
