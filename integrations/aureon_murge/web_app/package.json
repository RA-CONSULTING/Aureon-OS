  "type": "module",
  "scripts": {
    "unavailable": "node -e process.exitCode=2",
    "start": "npm run unavailable -- start",
    "runtime:start": "npm run unavailable -- runtime:start",
    "desktop:install": "npm run unavailable -- desktop:install",
    "desktop:start": "npm run unavailable -- desktop:start",
    "desktop:smoke": "npm run unavailable -- desktop:smoke",
    "aureon:cli": "npm run unavailable -- aureon:cli",
    "sandbox:build": "npm run unavailable -- sandbox:build",
    "check": "npm run check:node",
