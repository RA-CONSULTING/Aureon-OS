# AUREON PHI-RADAR CONFIGURATION
# Prime Sentinel: Gary Leckey
# Date: 2026-09-02
# Charlie rule: the credential lines below are placeholder names
# (REDACTED_USE_CLOUD_SECRET). Never replace them in this file with a real key.
# A real value belongs only in the gitignored .env.
# Warning: the master launcher reads the gitignored aureon_radar/.env
# (this example is not that file), the root .env, and the inherited shell.
# A complete Kraken, Binance, Alpaca, or Capital.com key group in any of
# those three arms a full-autonomy boot even when the root .env secret
# lines are blank. Exchange keys in .env make that boot live. Disable and
# dry-run flags in the root template are not a lock on that full+keyed
# master boot.

# ═══════════════════════════════════════════════════════════════════════════════
# CAPITAL.COM API CREDENTIALS
# ═══════════════════════════════════════════════════════════════════════════════
# Get these from your Capital.com account dashboard
# DEMO credentials (for shadow/paper trading)
CAPITAL_DEMO_API_KEY=REDACTED_USE_CLOUD_SECRET
CAPITAL_DEMO_API_SECRET=REDACTED_USE_CLOUD_SECRET

# LIVE credentials (for real trading — only used when ARMED)
CAPITAL_LIVE_API_KEY=REDACTED_USE_CLOUD_SECRET
CAPITAL_LIVE_API_SECRET=REDACTED_USE_CLOUD_SECRET

# ═══════════════════════════════════════════════════════════════════════════════
# OLLAMA CLOUD API
# ═══════════════════════════════════════════════════════════════════════════════
# Point to your cloud Ollama instance
OLLAMA_API_URL=http://your-ollama-server:11434
OLLAMA_MODEL=llama3.1:8b

# ═══════════════════════════════════════════════════════════════════════════════
# TRADING PARAMETERS
# ═══════════════════════════════════════════════════════════════════════════════
# Risk per trade (% of account balance)
RISK_PER_TRADE=0.01

# Profit target (%)
PROFIT_TARGET=0.01

# Stop loss (%)
STOP_LOSS=0.005

# Minimum confidence to trade
MIN_CONFIDENCE=0.65

# Minimum shadow win rate to allow ARMING
MIN_SHADOW_WIN_RATE=0.60

# ═══════════════════════════════════════════════════════════════════════════════
# MONITORED SYMBOLS
# ═══════════════════════════════════════════════════════════════════════════════
# Energy sector focus
SYMBOLS=XLE,XOP,VDE,OIH,IXC,USO,UNG

# ═══════════════════════════════════════════════════════════════════════════════
# PHI-SCALED INTERVALS (seconds)
# ═══════════════════════════════════════════════════════════════════════════════
PHI_ANCHOR=60
PHI_BASE=97
PHI_GROWTH=157
PHI_RETURN=254
PHI_HARMONIC=411
PHI_FIELD=665

# ═══════════════════════════════════════════════════════════════════════════════
# GATE POLICY
# ═══════════════════════════════════════════════════════════════════════════════
# System starts DISARMED. Shadow trades run first.
# To ARM for live trading: python aureon_phi_radar.py --arm
# To DISARM: python aureon_phi_radar.py --disarm
# PANIC: python aureon_phi_radar.py --panic
