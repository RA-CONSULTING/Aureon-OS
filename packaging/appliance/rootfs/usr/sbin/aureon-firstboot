#!/bin/sh
# Aureon appliance owner-console boundary: terminal HOLD.
set -eu

case "${1:-}" in
    --status)
        test "$#" -eq 1
        printf '%s\n' 'Aureon appliance runtime is on protection HOLD.'
        exit 1
        ;;
    --console-gate|"")
        test "$#" -le 1
        ;;
    *)
        printf '%s\n' 'usage: aureon-firstboot [--status|--console-gate]' >&2
        exit 64
        ;;
esac

printf '%s\n' '{"core_started":false,"decision":"HOLD","file_written":false,"network_accessed":false,"process_start_authorized":false,"reason":"native_appliance_release_boundary_required","schema":"aureon.appliance.firstboot-hold.v2","target_enabled":false}'
exit 1
