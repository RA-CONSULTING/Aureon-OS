#!/bin/sh
set -eu

policy_hold() {
    printf '%s\n' "AUREON_APPLIANCE_POLICY_HOLD $1"
    exit 78
}

require_enablement() {
    unit=$1
    expected=$2
    actual=$(systemctl is-enabled "$unit" 2>/dev/null || true)
    if [ "$actual" != "$expected" ]; then
        policy_hold "unexpected_enablement unit=$unit expected=$expected actual=${actual:-unknown}"
    fi
}

for unit in aureon-appliance.target aureon-operator.service aureon-organism.service \
    aureon-hnc.service aureon-boot-attestation.service aureon-firstboot-console.service; do
    fragment=$(systemctl show --property=FragmentPath --value "$unit" 2>/dev/null || true)
    if [ "$fragment" != "/usr/lib/systemd/system/$unit" ]; then
        policy_hold "fragment_mismatch unit=$unit"
    fi
    drop_ins=$(systemctl show --property=DropInPaths --value "$unit" 2>/dev/null || true)
    if [ -n "$drop_ins" ]; then
        policy_hold "drop_in_present unit=$unit"
    fi
done

require_enablement aureon-boot-attestation.service enabled
require_enablement aureon-firstboot-console.service enabled
require_enablement getty@tty1.service masked

for unit in aureon-appliance.target aureon-operator.service aureon-organism.service aureon-hnc.service; do
    require_enablement "$unit" disabled
    if systemctl is-active --quiet "$unit"; then
        policy_hold "unexpected_active_unit=$unit"
    fi
done

if [ -e /etc/aureon/firstboot.complete ]; then
    policy_hold "unexpected_firstboot_marker"
fi

printf '%s\n' 'AUREON_APPLIANCE_BOOTABLE_PROTECTION_HOLD'
printf '%s\n' '{"schema":"aureon.appliance.boot.v1","status":"hold","reason":"native_appliance_release_boundary_required","core_started":false}'
