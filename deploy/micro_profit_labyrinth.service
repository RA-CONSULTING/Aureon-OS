[Unit]
Description=Aureon market-trader protection preflight (terminal HOLD)

[Service]
Type=oneshot
WorkingDirectory=/workspaces/aureon-trading
ExecStart=/usr/bin/python3 -I -S -B /workspaces/aureon-trading/scripts/bootstrap/protected_bootstrap_v05.py --target-id unified-market-trader
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
