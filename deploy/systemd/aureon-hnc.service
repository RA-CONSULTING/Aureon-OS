[Unit]
Description=Aureon HNC protection preflight (terminal HOLD)
PartOf=aureon.target

[Service]
Type=oneshot
User=aureon
WorkingDirectory=/opt/aureon
ExecStart=/opt/aureon/.venv/bin/python -I -S -B /opt/aureon/scripts/bootstrap/protected_bootstrap_v05.py --target-id hnc
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true

[Install]
WantedBy=aureon.target
