[Unit]
Description=Aureon whole-system protection preflight (terminal HOLD)

[Service]
Type=oneshot
User=aureon
WorkingDirectory=/opt/aureon
ExecStart=/opt/aureon/.venv/bin/python -I -S -B /opt/aureon/scripts/bootstrap/protected_bootstrap_v05.py --target-id linux-supervisor
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
