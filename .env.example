# Public environment template. Copy to `.env` only on your own machine.
# `.env` is gitignored. This file is the committable template.
#
# Charlie rule: placeholder names only. Never a real key value.
# Every secret line below is blank on purpose. The name is the placeholder.
# A real key, token, password, or account secret belongs only in `.env`
# or in the operator's secret store. Do not paste one here.
# Exchange keys in `.env` make that boot live. A non-blank Kraken, Binance,
# Alpaca, or Capital.com key group is what `scripts/launch/aureon-master.sh`
# treats as live when autonomy is full (the public default).
# A blank root `.env` is not enough to stay on paper. A complete key group
# in the inherited shell, or in `aureon_radar/.env`, arms that same boot
# even when every secret line in this file is blank.
#
# `./install.sh` does not read this file. The local plug-and-play command
# boots with exchange keys unset. It does not call an external language-model
# API. HNC, Auris, and QGITA run in this repository. The release boundary
# stays HOLD.
#
# Three postures. The copied file is posture 1 and 2. Posture 3 names the
# values a fresh blank-key copy contains. Those values are not a lock on
# the master launcher.
#
# 1. Guarded offline — no keys, no market call, no order.
#    Leave this file unused, or copy it and leave every secret blank.
#    `./install.sh` applies these in the process (it does not write them here)
#    and skips `.env`:
#      autonomy mode guarded
#      AUREON_LLM_OFFLINE=1
#      AUREON_SUPPRESS_IMPORT_SIDE_EFFECTS=1
#      AUREON_PLUG_AND_PLAY=1
#      real orders disabled, exchange mutations disabled, live trading off
#    That process is not the master launcher. The master launcher reads the
#    inherited shell and `aureon_radar/.env`. Shell form of the offline pytest
#    path is in the root README.
#
# 2. Read-only market fetch — public REST, no key, no order.
#    Still leave every secret blank. The fetcher does not read an exchange key.
#    Live fetch:
#      AUREON_DISABLE_REAL_ORDERS=1 PYTHONPATH=. python3 -m aureon.evaluation.market_series --out reports/measured
#    Check the pack already on disk, with no network:
#      PYTHONPATH=. python3 -m aureon.evaluation.market_series --check --out reports/measured
#    Optional provider names further down are unused by that command.
#
# 3. Live orders — template values, not a master lock.
#    This file does not assign the live-trading switch. Leave it unset.
#    The lines below are what a fresh blank-key copy contains: paper and demo
#    venue URLs, and disable / dry-run flags. They describe the file. They
#    hold for a master boot that finds no complete exchange key group.
#    They are not a lock. A full+keyed master boot overrides
#    AUREON_DISABLE_REAL_ORDERS, AUREON_DISABLE_EXCHANGE_MUTATIONS,
#    AUREON_ORDER_INTENT_PUBLISH, AUREON_UNIFIED_ORDER_EXECUTOR,
#    AUREON_DRY_RUN, and DRY_RUN with the live profile. Exchange keys in
#    `.env` make that boot live. The same override runs when the complete
#    group is only in the inherited shell or in `aureon_radar/.env`.
#    ALPACA_PAPER and CAPITAL_DEMO stay as written here; the live profile
#    does not rewrite those venue lines.
#    Names, and the values this template ships:
#      AUREON_DISABLE_REAL_ORDERS=1
#      AUREON_DISABLE_EXCHANGE_MUTATIONS=1
#      AUREON_ORDER_INTENT_PUBLISH=0
#      AUREON_UNIFIED_ORDER_EXECUTOR=0
#      AUREON_DRY_RUN=1
#      DRY_RUN=1
#      ALPACA_PAPER=true
#      CAPITAL_DEMO=1
#      CAPITAL_DEMO_MODE=true
#    See docs/PUBLIC_ENV.md.

# ── Template values (blank-key copy; not a full+keyed master lock) ───────────
AUREON_LLM_OFFLINE=1
AUREON_DISABLE_REAL_ORDERS=1
AUREON_DISABLE_EXCHANGE_MUTATIONS=1
AUREON_ORDER_INTENT_PUBLISH=0
AUREON_UNIFIED_ORDER_EXECUTOR=0
AUREON_DRY_RUN=1
DRY_RUN=1

# QuickBooks Online Accounting API
# Keep QUICKBOOKS_ALLOW_MUTATION=false until a separately approved write run.
# OAuth tokens are stored in the git-ignored Windows DPAPI vault, not here.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_CLIENT_CREDENTIAL_VAULT=.aureon/quickbooks_client_credentials.dpapi.json
QUICKBOOKS_TOKEN_VAULT=.aureon/quickbooks_tokens.dpapi.json
QUICKBOOKS_REDIRECT_URI=http://localhost:8765/callback
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REALM_ID=
QUICKBOOKS_MINOR_VERSION=75
QUICKBOOKS_TIMEOUT_SECONDS=30
QUICKBOOKS_ALLOW_MUTATION=false
AUREON_ACCOUNTING_APPROVAL_HMAC_KEY=
AUREON_ACTIVE_GRANT_LEDGER=

# Production QuickBooks uses different credentials and must use separate vaults.
# It also requires an HTTPS public redirect URI and approved Intuit production assessment.
# QUICKBOOKS_ENVIRONMENT=production
# QUICKBOOKS_CLIENT_CREDENTIAL_VAULT=.aureon/quickbooks_production_client_credentials.dpapi.json
# QUICKBOOKS_TOKEN_VAULT=.aureon/quickbooks_production_tokens.dpapi.json
# QUICKBOOKS_REDIRECT_URI=https://aureonzorzatechnologies.pl/quickbooks/oauth/callback

# Binance — blank placeholder. A value belongs in `.env`, never here.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Kraken — blank placeholder. A value belongs in `.env`, never here.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Alpaca — paper stays on. A key value belongs in `.env`, never here.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Capital.com — demo stays on. A key value belongs in `.env`, never here.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=
CAPITAL_DEMO=1
CAPITAL_DEMO_MODE=true

# CoinAPI (optional: used for cross-exchange market history/anomaly detection)
COINAPI_KEY=

# ── Data sources (all optional; manage + test them in the Connections UI) ─────
# Market data & macro. Read-only market fetch in posture 2 does not read these.
COINGECKO_API_KEY=
FRED_API_KEY=
FMP_API_KEY=
# Space & science (production requests fail explicitly when a required key is absent)
NASA_API_KEY=
FIRMS_MAP_KEY=
NOAA_API_KEY=
USGS_API_KEY=
# On-chain & whale flow
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
ALCHEMY_NETWORK=eth-mainnet
COVALENT_API_KEY=
GLASSNODE_API_KEY=
UNUSUAL_WHALES_API_KEY=
# News & social
WORLD_NEWS_API_KEY=
# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Aureon Operator switchboard — AI providers (all optional) ─────────────────
# Guarded offline (posture 1) leaves these blank. The operator fans a prompt
# out across whichever of these are set in `.env`, then grounds and collapses
# the answers through the Aureon repo. With none set, and with
# AUREON_LLM_OFFLINE=1, it stays on the offline adapter.
# See docs/architecture/AUREON_OPERATOR_SWITCHBOARD.md
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Ollama / self-hosted language cortex (OpenAI-compatible) ──────────────────
# Setting AUREON_LLM_BASE_URL in `.env` turns the self-hosted "local" line live
# on the switchboard. Works with Ollama, vLLM, llama.cpp, LocalAI, and Ollama Cloud.
# Leave the key blank in this template.
#
#   Local Ollama (on the same machine as the operator), written in `.env`:
#     AUREON_LLM_BASE_URL=http://localhost:11434/v1
#     AUREON_LLM_MODEL=llama3.1
#     AUREON_LLM_API_KEY=
#
#   Ollama Cloud, written in `.env` only:
#     AUREON_LLM_BASE_URL=https://ollama.com/v1
#     AUREON_LLM_MODEL=gpt-oss:120b
#     OLLAMA_API_KEY=
#     AUREON_EXTERNAL_LLM_FALLBACK=ollama
#     AUREON_OLLAMA_REASONING_EFFORT=none
#
# The Ollama "Device Keys" (ssh-ed25519 …) register a machine. They are not
# the API key and do not go here. Create a cloud API key in the Ollama
# account settings and store it in `.env`.
AUREON_LLM_BASE_URL=
AUREON_LLM_MODEL=
OLLAMA_API_KEY=
AUREON_EXTERNAL_LLM_FALLBACK=ollama
AUREON_OLLAMA_REASONING_EFFORT=none
# Backward-compatible aliases: AUREON_OLLAMA_API_KEY, AUREON_LLM_API_KEY

# ── More OpenAI-compatible providers (or set them in the Providers UI) ────────
# The Providers settings page writes these into an encrypted local keystore; you
# can also set them in `.env`. Each is key-gated — a line only joins the
# switchboard once its key is present. This template keeps the values blank.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
MISTRAL_API_KEY=
MISTRAL_BASE_URL=
GROQ_API_KEY=
GROQ_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=

# ── Production data truth and live execution ────────────────────────────────
# Use runtime secret management for real values. This template stays blank.
# Live order limits stay unset here. Posture 3 above keeps execution off.
MASTER_ENCRYPTION_KEY=
AUREON_INGEST_TOKEN=
QUEEN_HIVE_MAX_ORDER_USD=
QUEEN_HIVE_MAX_EQUITY_FRACTION=
EXECUTION_MAX_PRICE_DEVIATION_BPS=
KELLY_LOOKBACK_TRADES=
KELLY_MAX_SAMPLE_AGE_HOURS=
KELLY_MAX_POSITION_PCT=
KELLY_MIN_POSITION_PCT=

