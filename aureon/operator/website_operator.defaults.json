  "ethos": {
    "principles": [
      "One shared evidence-and-control core may support multiple mission-specific applications.",
      "Research is a proving ground for evidence discipline, not a shortcut to validation.",
      "Claim state, source provenance, boundaries, next proof and human authority stay visible.",
      "Submissions, acknowledgements, discussions, partners, customers, awards and investment are distinct states.",
      "The public website is read-only and never exposes operator, credential, grant, trading or client controls."
    ],
    "required_site_signals": [
      {
        "id": "evidence",
        "pattern": "\\bevidence\\b",
        "severity": "error",
        "message": "Critical routes do not collectively establish Aureon's evidence-led operating model."
      },
      {
        "id": "research",
        "pattern": "\\bresearch\\b",
        "severity": "error",
        "message": "Critical routes do not collectively establish the research proving ground."
      },
      {
        "id": "human-authority",
        "pattern": "\\bhuman (?:authority|review|approval|gate)\\b",
        "severity": "error",
        "message": "Critical routes do not make retained human authority visible."
      },
      {
        "id": "boundary",
        "pattern": "\\b(?:boundary|not an? (?:award|partner|customer|deployment|validation)|outcome pending)\\b",
        "severity": "error",
        "message": "Critical routes do not expose evidence or claim boundaries."
      }
    ],
    "prohibited_claim_patterns": [
      {
        "id": "guaranteed-outcome",
        "pattern": "\\bguaranteed (?:result|results|return|returns|outcome|outcomes|success)\\b",
        "severity": "error",
        "message": "Guaranteed outcomes require removal; the site must state bounded evidence."
      },
      {
        "id": "proven-traction",
        "pattern": "\\bproven (?:revenue|market traction|customer traction|commercial traction)\\b",
        "severity": "error",
        "message": "Commercial proof may be claimed only from an attributable controlled record."
      },
      {
        "id": "unbounded-autonomy",
        "pattern": "\\bfully autonomous\\b",
        "severity": "error",
        "message": "The public site must not imply unbounded autonomous authority."
      },
      {
        "id": "unsupported-superlative",
        "pattern": "\\b(?:industry-leading|world-leading|best-in-class)\\b",
        "severity": "warning",
        "message": "Marketing superlatives require an attributable comparison or should be replaced."
      }
    ],
    "claim_inputs": [
      {
        "path": "website/data/blades.json",
        "schema": "aureon-sector-blades-v1",
        "required": true
      },
      {
        "path": "website/data/research-catalogue.json",
        "required": true
      },
      {
        "path": "website/data/funding-status.json",
        "required": true
      },
      {
        "path": "website/data/operator-evidence.json",
        "required": true
      }
    ]
  },
