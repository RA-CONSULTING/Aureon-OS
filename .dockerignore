# Optimize Docker builds by excluding unnecessary files
.git
.github
.venv
venv
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info
dist
build
*.log
*.pot
.coverage
.pytest_cache
.DS_Store
# Runtime credentials are injected by the deployment environment and must
# never become image-layer content. Keep the documented example available.
.env
.env.*
.env1
!.env.example
secrets/
*.pem
*.key
id_rsa*
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea
.vscode
*.swp
*.swo
*~
.mypy_cache
.dmypy.json
dmypy.json
htmlcov
.tox
.hypothesis

# Historical source bundles are evidence only, never image build input.
imports/
archive/

# Documentation
*.md
docs/
*.txt
!requirements.txt

# Test files
test_*.py
*_test.py
tests/

# Large data files (if any)
*.csv
*.xlsx
*.db
*.sqlite
