FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/aureon
COPY scripts/bootstrap/protected_bootstrap_v05.py /opt/aureon/scripts/bootstrap/protected_bootstrap_v05.py

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/python", "-I", "-S", "-B", "/opt/aureon/scripts/bootstrap/protected_bootstrap_v05.py", "--target-id", "ephemeris-pipeline"]
CMD []
